[Unit]
Description=Monthly Payment Reminder Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=paymentbot
Group=paymentbot
WorkingDirectory=/opt/payment-reminder
EnvironmentFile=/etc/payment-reminder.env
ExecStart=/opt/payment-reminder/.venv/bin/python app.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/payment-reminder /var/backups/payment-reminder /tmp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
